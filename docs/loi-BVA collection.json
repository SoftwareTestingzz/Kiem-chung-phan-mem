      "name": "1. ACC - Admin Accounts BVA",
      "item": [
        {
          "name": "ACC-BVA-01 | Get all accounts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/accounts"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('TC-ACC-BVA-01', () => pm.response.to.have.status(200));",
                "let json = pm.response.json();",
                "pm.expect(json).to.have.property('data');",
                "// Tự động lấy accountId đầu tiên từ response và gán vào biến môi trường test_account_id",
                "if (json && json.data && json.data.length > 0) {",
                "    pm.environment.set('test_account_id', json.data[0]._id || json.data[0].id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "ACC-BVA-02 | Create account (valid)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{ \"fullName\": \"Admin {{timestamp}}\", \"email\": \"test{{timestamp}}@mail.com\", \"password\": \"123456\", \"role_id\": \"{{test_role_id}}\" }"
            },
            "url": "{{base_url}}/admin/accounts/create"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('TC-ACC-BVA-02', () => pm.expect([200,302]).to.include(pm.response.code));",
                "if (pm.response.headers.get('Content-Type')?.includes('json')) {",
                " let json = pm.response.json();",
                " if (json.account) pm.environment.set('test_account_id', json.account._id);",
                "}"
              ]
            }
          }]
        },
