{
  "name": "product-management",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "nodemon --inspect index.js",
    "test": "cross-env NODE_ENV=test jest --testTimeout=30000",
    "test:unit": "cross-env NODE_ENV=test jest --testPathPatterns=tests/unit --testTimeout=10000",
    "test:integration": "cross-env NODE_ENV=test jest --testPathPatterns=\"tests/(admin|client)\" --testTimeout=30000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:with-jira": "node jira-integration/newman-jira-runner.js --collection docs/son-collection.json --environment docs/shared-environment.json",
    "seed": "node seeds/index.seed.js",
    "seed:admin": "node seeds/admin.seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "projects": [
      {
        "displayName": "unit",
        "testMatch": ["<rootDir>/tests/unit/**/*.test.js"],
        "setupFilesAfterEnv": ["<rootDir>/tests/unit/setup.unit.js"],
        "testEnvironment": "node"
      },
      {
        "displayName": "integration",
        "testMatch": ["<rootDir>/tests/admin-*.test.js", "<rootDir>/tests/client-*.test.js"],
        "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
        "testEnvironment": "node"
      }
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "services/**/*.js",
      "!tests/**"
    ]
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "docx": "^8.5.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-flash": "^0.0.2",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "method-override": "^3.0.0",
    "mongoose": "^8.19.0",
    "mongoose-slug-updater": "^3.3.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "pug": "^3.0.3",
    "slugify": "^1.6.6",
    "tinymce": "^8.2.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "newman": "^6.2.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  }
}